<Window x:Class="WpfAEmailApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WpfAEmailApp.Views"
        Title="WpfAEmailApp - Gestionnaire Tout-en-un" Height="650" Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <!-- Onglets principaux de l'application -->
        <TabControl>

            <!-- Onglet 1 : Gestion des e-mails (votre application d'origine) -->
            <TabItem Header="Boîte Mail">
                <views:EmailView />
            </TabItem>

            <!-- Onglet 2 : To-Do List -->
            <TabItem Header="To-Do List">
                <views:TodoView />
            </TabItem>

            <!-- Onglet 3 : Chronomètre Analogique -->
            <TabItem Header="Chronomètre">
                <views:StopwatchView />
            </TabItem>

        </TabControl>
    </Grid>
</Window>