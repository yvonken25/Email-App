<Window x:Class="WpfAEmailApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire d'Envoi d'E-mails" Height="592" Width="729"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Expéditeur -->
        <Label Content="Votre e-mail :" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="TxtExpediteur" Grid.Row="0" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"/>

        <!-- Mot de passe / Clé d'application -->
        <Label Content="Clé d'application :" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <PasswordBox x:Name="TxtPassword" Grid.Row="1" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"/>

        <!-- Destinataire -->
        <Label Content="Destinataire :" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="TxtDestinataire" Grid.Row="2" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"/>

        <!-- Objet -->
        <Label Content="Objet du message :" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <TextBox x:Name="TxtObjet" Grid.Row="3" Grid.Column="1" Margin="0,5" Height="28" VerticalContentAlignment="Center"/>

        <!-- Message -->
        <Label Content="Message :" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,5"/>
        <TextBox x:Name="TxtMessage" Grid.Row="4" Grid.Column="1" Margin="0,5,0,191" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <!-- Bouton d'envoi -->
        <Button x:Name="BtnEnvoyer" Content="Envoyer le mail" Grid.Row="4" Grid.Column="1" Height="35" Margin="0,248,0,99"
                Background="#007ACC" Foreground="White" FontWeight="Bold" Click="BtnEnvoyer_Click"/>
    </Grid>
</Window>